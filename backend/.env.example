# AibaPM Work Version - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# AZURE OPENAI CONFIGURATION (Required)
# ===========================================
# Get these from your Azure portal under your Azure OpenAI resource

# Your Azure OpenAI endpoint URL
# Example: https://your-resource-name.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=

# Your deployment name (the name you gave when deploying a model)
# This is NOT the model name - it's the name of your deployment
# Example: gpt-4o-deployment, gpt-5, my-chat-model
AZURE_OPENAI_DEPLOYMENT=

# API version (usually don't need to change this)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Port for the backend server
PORT=3001

# Environment mode
NODE_ENV=development

# ===========================================
# OPTIONAL SETTINGS
# ===========================================

# Password protection (leave empty for no password)
# If set, users must enter this password to access the app
APP_PASSWORD=

# CORS origins (comma-separated list for production)
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=

# How many days to keep transcript files (default: 30)
AUDIO_RETENTION_DAYS=30
